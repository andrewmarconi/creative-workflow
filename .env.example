# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True

# Database (Postgres via Docker)
POSTGRES_DB=cw
POSTGRES_USER=cw
POSTGRES_PASSWORD=cw_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5435

# Valkey/Redis (via Docker)
VALKEY_HOST=localhost
VALKEY_PORT=6379

# Optional: Anthropic API for LLM-based prompt enhancement
# ANTHROPIC_API_KEY=your-api-key-here

# For downloading LoRAs from CivitAI.
# CIVITAI_API_KEY=your-api-key-here

# OpenTelemetry / Jaeger (tracing)
# Set to 'true' to enable tracing and send telemetry to Jaeger
# Access Jaeger UI at http://localhost:16686
OTEL_ENABLED=false
OTEL_SERVICE_NAME=creative-workflow
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ENVIRONMENT=development