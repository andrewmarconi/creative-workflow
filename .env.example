# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True

# Database (Postgres via Docker)
POSTGRES_DB=cw
POSTGRES_USER=cw
POSTGRES_PASSWORD=cw_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5435

# Valkey/Redis (via Docker)
VALKEY_HOST=localhost
VALKEY_PORT=6379

# Optional: Anthropic API for LLM-based prompt enhancement
# ANTHROPIC_API_KEY=your-api-key-here

# For downloading LoRAs from CivitAI.
# CIVITAI_API_KEY=your-api-key-here

# Grafana Loki - Log aggregation and search
# Logs are written to logs/*.log and automatically collected by Promtail
# View and search logs at http://localhost:3000 (Grafana UI)
# No API key required - runs locally via docker-compose


KAGGLE_API_TOKEN=your-api-key-here