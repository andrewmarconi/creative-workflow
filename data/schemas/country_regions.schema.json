{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Country-Region Mappings Schema",
  "description": "Schema for many-to-many mappings between countries and regions",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["country_code", "region_code"],
    "properties": {
      "country_code": {
        "type": "string",
        "description": "ISO 3166-1 alpha-2 country code (references countries.code)",
        "minLength": 2,
        "maxLength": 2,
        "pattern": "^[A-Z]{2}$"
      },
      "region_code": {
        "type": "string",
        "description": "Region code (references regions.code)",
        "minLength": 1,
        "pattern": "^[A-Z_]+$"
      }
    },
    "additionalProperties": false
  }
}
