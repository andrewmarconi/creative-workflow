{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Countries Schema",
  "description": "Schema for countries with cultural, regulatory, and language information",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["code", "name", "default_language", "is_active"],
    "properties": {
      "code": {
        "type": "string",
        "description": "ISO 3166-1 alpha-2 country code (e.g., 'US', 'GB', 'JP')",
        "minLength": 2,
        "maxLength": 2,
        "pattern": "^[A-Z]{2}$"
      },
      "name": {
        "type": "string",
        "description": "Official country name",
        "minLength": 1
      },
      "default_language": {
        "type": "string",
        "description": "Default language code for the country (e.g., 'en-US', 'fr-FR')",
        "minLength": 1
      },
      "insights": {
        "type": "array",
        "description": "Cultural, regulatory, and market insights for the country",
        "items": {
          "type": "object",
          "required": ["heading", "points"],
          "properties": {
            "heading": {
              "type": "string",
              "description": "Insight category heading (e.g., 'Regulatory environment', 'Cultural considerations')",
              "minLength": 1
            },
            "points": {
              "type": "array",
              "description": "List of insight points",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        }
      },
      "notes": {
        "type": "string",
        "description": "Additional notes about the country"
      },
      "is_active": {
        "type": "boolean",
        "description": "Whether the country is currently active"
      }
    },
    "additionalProperties": false
  }
}
